{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parquet Viewer",
  "version": "0.5.0",
  "identifier": "de.sustineo.parquetviewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Parquet Viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "parquet"
        ],
        "name": "Parquet file",
        "description": "Apache Parquet data file",
        "role": "Viewer",
        "mimeType": "application/vnd.apache.parquet"
      }
    ],
    "publisher": "Fabian Eulitz",
    "homepage": "https://fabieu.github.io/parquet-viewer/",
    "copyright": "Copyright (c) 2026 Fabian Eulitz",
    "license": "MIT",
    "shortDescription": "Fast, read-only viewer for Parquet files",
    "longDescription": "Parquet Viewer opens Parquet files of any size in an instant and lets you scroll, filter and sort them with plain SQL, without importing anything. It reads only the rows you are looking at, everything runs locally, and files are never modified.",
    "category": "DeveloperTool",
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/metainfo/de.sustineo.parquetviewer.metainfo.xml": "linux/de.sustineo.parquetviewer.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/de.sustineo.parquetviewer.metainfo.xml": "linux/de.sustineo.parquetviewer.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/de.sustineo.parquetviewer.metainfo.xml": "linux/de.sustineo.parquetviewer.metainfo.xml"
        }
      }
    }
  }
}

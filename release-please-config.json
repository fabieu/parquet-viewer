{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "parquet-viewer",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "packages/tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "packages/tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value === 'parquet-viewer')].version"
        },
        {
          "type": "json",
          "path": "packages/tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}

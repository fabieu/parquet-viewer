{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parquet Viewer",
  "version": "0.1.0",
  "identifier": "de.sustineo.parquetviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Parquet Viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "parquet"
        ],
        "name": "Parquet file",
        "description": "Apache Parquet data file",
        "role": "Viewer",
        "mimeType": "application/vnd.apache.parquet"
      }
    ],
    "shortDescription": "Fast, read-only viewer for Parquet files",
    "category": "DeveloperTool"
  }
}
